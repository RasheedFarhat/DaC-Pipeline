<group name="windows,sysmon,">
  <rule id="100006" level="10">
    <decoded_as>json</decoded_as>
    <field name="win.eventdata.image" type="pcre2">(?i)certutil\\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)urlcache.*split</field>
    <description>Suspicious Certutil Network Connection (MITRE T1105).</description>
    <mitre>
      <id>T1105</id>
    </mitre>
  </rule>
</group>
